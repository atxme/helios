{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion VPN",
  "version": "0.1.0",
  "identifier": "net.helios.orion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orion VPN",
        "width": 440,
        "height": 680,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["orionprofile"],
        "name": "Profil Orion",
        "description": "Profil de connexion VPN Orion",
        "mimeType": "application/x-orion-profile",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libcap2-bin"],
        "postInstallScript": "linux/postinst"
      }
    }
  }
}
