{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orion",
    "version": "4.0.1",
  "identifier": "net.helios.orion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orion",
        "width": 520,
        "height": 560,
        "minWidth": 500,
        "minHeight": 520,
        "resizable": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "orion"
        ],
        "name": "Orion.Profile",
        "description": "Profil de connexion Orion",
        "mimeType": "application/x-orion-profile",
        "role": "Editor"
      }
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libcap2-bin"
        ],
        "postInstallScript": "linux/postinst"
      }
    }
  }
}
