{
  "build": {
    "beforeBuildCommand": "npm run orion-deps && npm run build"
  },
  "bundle": {
    "resources": {
      "../../../resources-windows/": "resources-windows/",
      "icons/orion-profile.ico": "orion-profile.ico"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "nsis": {
        "installMode": "perMachine"
      },
      "wix": {
        "fragmentPaths": [
          "windows/orion-profile-icon.wxs"
        ],
        "componentRefs": [
          "OrionProfileIcon"
        ]
      },
      "signCommand": {
        "cmd": "powershell.exe",
        "args": [
          "-NoLogo",
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "windows/sign-orion.ps1",
          "%1"
        ]
      }
    }
  }
}
