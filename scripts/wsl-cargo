#!/usr/bin/env bash
# Cargo entry point for the WSL development checks.
#
# WSL's VHD grows with every distinct Cargo target directory and does not
# automatically shrink after a clean. Keep routine checks in one bounded cache
# instead of leaving a target directory per worktree or review task. The
# budget itself lives in cargo-budget.sh, shared with the build scripts.
set -euo pipefail

if [ "$#" -eq 0 ]; then
    echo "Usage: scripts/wsl-cargo <cargo arguments...>" >&2
    exit 2
fi

if ! grep -qiE '(microsoft|wsl)' /proc/sys/kernel/osrelease 2>/dev/null; then
    exec cargo "$@"
fi

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=scripts/cargo-budget.sh
source "$repo_root/scripts/cargo-budget.sh"
helios_budget_enter "$repo_root"

# Full workspace checks gain little from incremental state, which accounts for
# several GiB on Helios. Leave focused development commands incremental.
full_workspace=0
for argument in "$@"; do
    if [ "$argument" = "--workspace" ]; then
        full_workspace=1
        break
    fi
done
if [ "$full_workspace" = "1" ] \
    && { [ "$1" = "check" ] || [ "$1" = "clippy" ] || [ "$1" = "test" ]; }; then
    export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"
    echo "==> Validation workspace WSL sans compilation incrémentale"
fi

mkdir -p "$CARGO_TARGET_DIR"
# Cargo already serializes parts of a target directory, but this lock also
# covers the size check and prevents two independent wrappers from compiling
# concurrently into the one WSL cache.
exec 9>"$CARGO_TARGET_DIR/.helios-build.lock"
flock 9
if cargo "$@"; then
    status=0
else
    status=$?
fi

helios_budget_leave "$repo_root" || exit $?
exit "$status"
