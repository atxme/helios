# Astra — paramètres de déploiement (ADR-008).
#
#   cp deploy/astra/env.example deploy/astra/.env
#
# Rien ici n'est secret : ce sont des identifiants et des clés publiques. Le
# seul secret d'Astra est sa clé de service, qu'il génère lui-même au bootstrap
# dans son volume d'état, et qui n'en sort jamais.

# ── Choisi une fois, et jamais changé ────────────────────────────────────────
#
# Le RP ID WebAuthn. Un credential FIDO2 est créé SOUS un RP ID, et une
# assertion doit présenter le même : en changer rend tous les key-slots du
# coffre d'autorité inouvrables, définitivement et sans recours. Le coffre le
# mémorise à `astra-signer init`.
#
# La même valeur pour `astra-signer init --rp-id`, `astra bootstrap
# --webauthn-rp-id` et `heliosd init-trust-domain --webauthn-rp-id`.
ASTRA_RP_ID=astra.helios.local

# ── Imprimés par `astra-signer init` sur le poste opérateur ──────────────────
CA_PQ_PUBLIC=
TRUST_DOMAIN_ID=

# ── Lus sur la gateway ───────────────────────────────────────────────────────
#
# GATEWAY_WG_PUBLIC : `wg show helios0 public-key`
# SERVER_NAME       : ce qui a été passé à `heliosd init-key-negotiation
#                     --server-name` — le sujet de la leaf PQ que les clients
#                     épinglent. `heliosd init-trust-domain` le relit tout seul
#                     dans le certificat servi ; ici il faut le donner.
GATEWAY_WG_PUBLIC=
SERVER_NAME=

# ── Endpoint public ─────────────────────────────────────────────────────────
ASTRA_AUTHORITY_URL=https://astra.helios.local

# ── Imprimé par `astra bootstrap`, à reporter ici avant le premier `up` ─────
#
# Sans cette valeur, une restauration de sauvegarde qui a divergé est reprise
# en silence : deux histoires pour un même domaine, et aucun moyen de savoir
# laquelle les clients ont vue.
ASTRA_EXPECTED_AUDIT_HEAD=
