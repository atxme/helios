[Unit]
Description=Helios WireGuard gateway
Documentation=https://github.com/christophe/helios
# heliosd engage le kill-switch avant d'autoriser le moindre trafic.
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
Environment=HELIOS_NETWORK_CONFIG=/var/lib/helios/network.toml
Environment=HELIOS_UPDATE_CHANNEL=production
Environment=HELIOS_UPDATE_STAGING=/var/lib/helios/updates
Environment=HELIOS_INSTALL_ROOT=/opt/helios/releases
Environment=HELIOS_CURRENT_LINK=/opt/helios/current
Environment=HELIOS_READY_PATH=/run/helios/ready
ExecStart=/opt/helios/current/heliosd run
Restart=on-failure
RestartSec=2

# heliosd manipule nftables et l'interface WireGuard.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
# /dev/tpmrm0 appartient à tss:tss (mode 660). Le service tourne en root, mais
# CapabilityBoundingSet lui retire CAP_DAC_OVERRIDE : sans elle, root ne
# traverse plus les permissions de fichier et ne peut pas ouvrir le TPM. On lui
# rend l'accès par le groupe, pas en lui rendant le droit d'ignorer TOUTES les
# permissions — moindre privilège plutôt que CAP_DAC_OVERRIDE.
SupplementaryGroups=tss
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/helios
RuntimeDirectory=helios

[Install]
WantedBy=multi-user.target
