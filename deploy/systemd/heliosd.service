[Unit]
Description=Helios WireGuard gateway
Documentation=https://github.com/christophe/helios
# heliosd engage le kill-switch avant d'autoriser le moindre trafic.
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
Environment=HELIOS_NETWORK_CONFIG=/var/lib/helios/network.toml
Environment=HELIOS_UPDATE_CHANNEL=production
Environment=HELIOS_UPDATE_STAGING=/var/lib/helios/updates
Environment=HELIOS_INSTALL_ROOT=/opt/helios/releases
Environment=HELIOS_CURRENT_LINK=/opt/helios/current
Environment=HELIOS_READY_PATH=/run/helios/ready
ExecStart=/opt/helios/current/heliosd run
Restart=on-failure
RestartSec=2

# heliosd manipule nftables et l'interface WireGuard.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
# /dev/tpmrm0 appartient à tss:tss (mode 660). Le service tourne en root, mais
# CapabilityBoundingSet lui retire CAP_DAC_OVERRIDE : sans elle, root ne
# traverse plus les permissions de fichier et ne peut pas ouvrir le TPM. On lui
# rend l'accès par le groupe, pas en lui rendant le droit d'ignorer TOUTES les
# permissions — moindre privilège plutôt que CAP_DAC_OVERRIDE.
SupplementaryGroups=tss
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/helios
RuntimeDirectory=helios
# /run/helios porte le marqueur de disponibilité que l'installateur relit après
# avoir redémarré le démon. Sans `RuntimeDirectoryPreserve`, systemd détruit ce
# répertoire à chaque arrêt : celui que l'installateur provoque lui-même efface
# donc, en plein milieu de la bascule, le répertoire dont il attend le marqueur.
RuntimeDirectoryPreserve=yes

# Tout fichier créé par le démon naît en 0600 / 0700 (ADR-006). `save()` pose
# déjà le mode explicitement ; ceci couvre à la source tout ce qui écrirait sans
# y penser — fichiers temporaires, journaux, artefacts de mise à jour.
UMask=0077

# Rémanence mémoire : un vidage de core d'un processus qui tient une clé privée
# WireGuard en clair, c'est le secret déposé sur le disque. `LimitCORE` supprime
# le fichier ; `CoredumpFilter` vide l'ensemble des types de pages retenus, pour
# le cas où un collecteur tiers relèverait la limite.
# `CoredumpFilter=` vide conserverait la valeur héritée et ne filtrerait rien :
# la valeur explicite `0` est exigée (ADR-006 §6).
LimitCORE=0
CoredumpFilter=0
# Le trousseau noyau du service n'est partagé avec personne.
KeyringMode=private

# Durcissement (ADR-006 §6). Aucune de ces options n'est requise par heliosd :
# il manipule nftables et WireGuard par netlink, écrit dans /var/lib/helios, et
# ne charge aucun module ni ne touche aux cgroups.
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX

[Install]
WantedBy=multi-user.target
